<?xml version="1.0" encoding="UTF-8"?>
<!-- Écran de chargement : affiché du clic jusqu'à l'apparition de
     l'interface. Volontairement minimal (fond, nom, roue, texte) pour que
     Kodi le dessine tout de suite. Pas de fondu à l'ouverture : il doit
     couvrir l'accueil immédiatement. Pas de fondu à la fermeture non
     plus : Kodi n'ouvre l'interface qu'une fois cet écran disparu. -->
<window>
  <zorder>5</zorder>
  <controls>
    <control type="image">
      <left>0</left><top>0</top><width>1920</width><height>1080</height>
      <texture colordiffuse="FF0B0E13">ytl_white.png</texture>
    </control>
    <control type="label">
      <left>0</left><top>410</top><width>1920</width><height>90</height>
      <align>center</align><aligny>center</aligny>
      <font>font27</font><textcolor>FFE6192E</textcolor>
      <label>Wtube</label>
    </control>
    <control type="image">
      <left>912</left><top>520</top><width>96</width><height>96</height>
      <texture colordiffuse="FFE6192E">ytl_spinner.png</texture>
      <aspectratio>keep</aspectratio>
      <animation effect="rotate" start="0" end="-360" center="auto" time="900" loop="true" condition="true">Conditional</animation>
    </control>
    <control type="label">
      <left>0</left><top>640</top><width>1920</width><height>40</height>
      <align>center</align><aligny>center</aligny>
      <font>font13</font><textcolor>FFAAAAAA</textcolor>
      <label>$ADDON[plugin.video.wtube 30213]</label>
    </control>
  </controls>
</window>
