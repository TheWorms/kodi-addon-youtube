<?xml version="1.0" encoding="UTF-8"?>
<!-- Voile noir du fondu entre deux vidéos enchaînées (transition.py) -->
<window>
  <zorder>3</zorder>
  <animation effect="fade" start="0" end="100" time="1100" tween="sine" easing="inout">WindowOpen</animation>
  <animation effect="fade" start="100" end="0" time="800" tween="sine" easing="inout">WindowClose</animation>
  <controls>
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>1080</height>
      <texture colordiffuse="FF000000">ytl_white.png</texture>
    </control>
  </controls>
</window>
